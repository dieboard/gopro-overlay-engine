<layout>
    <composite x="260" y="30" name="date_and_time">
        <component type="datetime" x="0" y="0" format="%Y/%m/%d" size="32" align="right"/>
        <component type="datetime" x="0" y="24" format="%H:%M:%S.%f" truncate="5" size="48" align="right"/>
    </composite>

    <composite x="16" y="1760" name="location">
        <component type="text" x="0" y="0" size="64" align="left">Street: </component>
        <component type="metric" x="205" y="0" metric="street" size="64" align="left" cache="False"/>

        <component type="text" x="0" y="80" size="64" align="left">Locality: </component>
        <component type="metric" x="260" y="80" metric="locality" size="64" align="left" cache="False"/>
        
        <component type="text" x="0" y="160" size="64" align="left">District: </component>
        <component type="metric" x="250245" y="160" metric="district" size="64" align="left" cache="False"/>
        
        <component type="text" x="0" y="240" size="64" align="left">City: </component>
        <component type="metric" x="150" y="240" metric="city" size="64" align="left" cache="False"/>
        
        <component type="text" x="0" y="320" size="64" align="left">State: </component>
        <component type="metric" x="180" y="320" metric="state" size="64" align="left" cache="False"/>
    </composite>

    <composite x="3260" y="0" name="gps_info">
        <frame name="gps-lock" x="226" y="24" width="32" height="32" bg="0,0,0,128" cr="5" opacity="0.4">
            <component type="gps-lock-icon" size="32"/>
        </frame>

        <composite y="36">
            <component type="text" x="0" y="0" size="16" align="left">GPS INFO</component>
            <component type="text" x="0" y="24" size="16" align="left">Lat: </component>
            <component type="text" x="128" y="24" size="16" align="left">Lon: </component>
            <component type="metric" x="118" y="24" metric="lat" dp="6" size="16" align="right" cache="False"/>
            <component type="metric" x="256"    y="24" metric="lon" dp="6" size="16" align="right" cache="False"/>
        </composite>
    </composite>

    <composite x="16" y="1590" name="big_mph">
        <component type="metric_unit" metric="speed" units="speed" size="32">{:~c}</component>
        <component type="metric" x="0" y="0" metric="speed" units="speed" dp="0" size="160" />
    </composite>

    <component type="chart" name="gradient_chart" x="400" y="1980"/>

    <composite x="220" y="1980" name="gradient">
        <component type="text" x="70" y="0" size="16">SLOPE(%)</component>
        <component type="icon" x="0" y="0" file="slope-triangle.png" size="64"/>
        <component type="metric" x="70" y="18" metric="gradient" dp="0" size="32" />
    </composite>

    <composite x="16" y="1980" name="altitude">
        <component type="metric_unit" x="70" y="0" metric="alt" units="alt" size="16">ALT({:~C})</component>
        <component type="icon" x="0" y="0" file="mountain.png" size="64"/>
        <component type="metric" x="70" y="18" metric="alt" units="alt" dp="0" size="32" />
    </composite>

    <composite x="3770" y="1820" name="temperature">
        <component type="metric_unit" x="-70" y="0" size="16" align="right" metric="temp" units="temp">TEMP({:~C})</component>
        <component type="icon" x="-64" y="0" file="thermometer.png" size="64"/>
        <component type="metric" x="-70" y="18" dp="0" size="32" align="right" metric="temp" units="temp"/>
    </composite>

    <composite x="3770" y="1900" name="cadence">
        <component type="text" x="-70" y="0" size="16" align="right">RPM</component>
        <component type="icon" x="-64" y="0" file="gauge.png" size="64"/>
        <component type="metric" x="-70" y="18" metric="cadence" dp="0" size="32" align="right"/>
    </composite>

    <composite x="3770" y="1980" name="heartbeat">
        <component type="text" x="-70" y="0" size="16" align="right">BPM</component>
        <component type="icon" x="-64" y="0" file="heartbeat.png" size="64"/>
        <component type="metric" x="-70" y="18" metric="hr" dp="0" size="32" align="right"/>
    </composite>

    <!-- MAPS & CAIRO -->
    <component type="moving_map" name="moving_map" x="3260" y="100" size="512" zoom="17" corner_radius="35" />
    <component type="journey_map" name="journey_map" x="3260" y="700" size="512" corner_radius="35"/>

    <!-- NEW: CAIRO MAP ADDED -->
    <!-- Positioned at the same x/y as moving_map. Give it a unique name. -->
    <composite x="3260" y="600" name="cairo_map">
        <translate y="40">
            <component type="cairo-circuit-map" size="512" rotate="270" line-width="0.02" outline="0,0,255,255" loc-size="0.02" loc-fill="0,0,255" loc-outline="0,0,255"/>
        </translate>
    </composite>
</layout>